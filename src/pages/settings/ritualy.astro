---
import Shell from "../../layouts/Shell.astro";
import CustomRitualsManager from "../../components/CustomRitualsManager";
import { prisma } from "../../lib/db";
import { readSession } from "../../lib/session";
import { ensureBuiltinRituals } from "../../lib/rituals-server";

const session = await readSession(Astro.cookies);
if (!session) return Astro.redirect("/login");

const user = await prisma.user.findUnique({
  where: { id: session.uid },
  select: { username: true },
});
if (!user) return Astro.redirect("/login");

// Gideon 2026-08-13: vestavěné rituály jsou od teď editovatelné řádky
// (časy, dny, obsah, upozornění, Google sync) — jeden seznam pro všechny.
await ensureBuiltinRituals(session.uid);
---

<Shell
  title="Rituály · Rašeliniště"
  username={user.username}
  breadcrumb={[{ label: "Nastavení", href: "/settings" }, { label: "Rituály" }]}
>
  <div class="max-w-3xl space-y-5">
    <div>
      <h1 class="font-serif text-[2rem] leading-tight">Rituály</h1>
      <p class="text-sm text-muted-foreground mt-1.5">
        U každého rituálu jde upravit čas, dny, délku, obsah (markdown) i upozornění
        — a nechat ho propsat do Google kalendáře, ať ho vidíš i na iPhonu.
      </p>
    </div>

    <CustomRitualsManager client:load />
  </div>
</Shell>
